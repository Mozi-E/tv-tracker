# Copy to .env and fill in. .env is git-ignored - never commit real secrets.

# TMDB "API Key (v3 auth)" from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Bot token from @BotFather, looks like 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# Optional. A chat id that always receives alerts (even before anyone runs /start).
# Leave empty to rely only on people who have messaged the bot.
TELEGRAM_CHAT_ID=
